GPIO2.associatedPins[4].initialValue = "SET";

/* LCD背光独立使用PB16普通GPIO，为DAC0释放其唯一输出脚PA15。 */
GPIO5.$name                          = "LCD_BACKLIGHT";
GPIO5.port                           = "PORTB";
GPIO5.associatedPins[0].$name        = "BL";
GPIO5.associatedPins[0].assignedPin  = "16";
GPIO5.associatedPins[0].initialValue = "CLEARED";

GPIO3.$name                              = "KEYS";
