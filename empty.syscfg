/**
 * Import the modules used in this configuration.
 */
const ADC12  = scripting.addModule("/ti/driverlib/ADC12", {}, false);
const ADC121 = ADC12.addInstance();
const ADC122 = ADC12.addInstance();
const DAC12  = scripting.addModule("/ti/driverlib/DAC12");
const GPIO   = scripting.addModule("/ti/driverlib/GPIO", {}, false);
const GPIO1  = GPIO.addInstance();
const GPIO2  = GPIO.addInstance();
const GPIO3  = GPIO.addInstance();
const GPIO4  = GPIO.addInstance();
const GPIO5  = GPIO.addInstance();
const PWM    = scripting.addModule("/ti/driverlib/PWM", {}, false);
const PWM1   = PWM.addInstance();
const SYSCTL = scripting.addModule("/ti/driverlib/SYSCTL");
const TIMER  = scripting.addModule("/ti/driverlib/TIMER", {}, false);
const TIMER1 = TIMER.addInstance();

/**
 * Write custom configuration values to the imported modules.
 */
/*
 * ADC0 四通道序列采样：每个 TIMG0 周期依次转换 PA27、PA26、PA25、PA24。
 * FIFO 将两个 12 位结果打包为一个 32 位字，再由 DMA_CH0 搬入双缓冲区。
 */
ADC121.$name                             = "ADC_CAPTURE";
ADC121.repeatMode                        = false;
ADC121.powerDownMode                     = "DL_ADC12_POWER_DOWN_MODE_MANUAL";
ADC121.samplingOperationMode             = "sequence";
ADC121.endAdd                            = 3;
ADC121.trigSrc                           = "DL_ADC12_TRIG_SRC_EVENT";
ADC121.subChanID                         = 1;
ADC121.sampleTime0                       = "250 ns";
ADC121.adcMem0chansel                    = "DL_ADC12_INPUT_CHAN_0";
ADC121.adcMem1chansel                    = "DL_ADC12_INPUT_CHAN_1";
ADC121.adcMem2chansel                    = "DL_ADC12_INPUT_CHAN_2";
ADC121.adcMem3chansel                    = "DL_ADC12_INPUT_CHAN_3";
ADC121.configureDMA                      = true;
ADC121.enableFIFO                        = true;
ADC121.sampCnt                           = 2;
ADC121.enabledDMATriggers                = ["DL_ADC12_DMA_MEM3_RESULT_LOADED"];
ADC121.enabledInterrupts                 = ["DL_ADC12_INTERRUPT_DMA_DONE"];
ADC121.peripheral.$assign                = "ADC0";
ADC121.peripheral.adcPin0.$assign        = "PA27";
ADC121.peripheral.adcPin1.$assign        = "PA26";
ADC121.peripheral.adcPin2.$assign        = "PA25";
ADC121.peripheral.adcPin3.$assign        = "PA24";
ADC121.adcPin0Config.$name               = "ti_driverlib_gpio_GPIOPinGeneric0";
ADC121.adcPin0Config.hideOutputInversion = scripting.forceWrite(false);
ADC121.DMA_CHANNEL.$name                 = "ADC_DMA";
ADC121.DMA_CHANNEL.addressMode           = "f2b";
ADC121.DMA_CHANNEL.peripheral.$assign    = "DMA_CH0";

/*
 * ADC1 高速单通道：PB27 对应 ADC1 通道14。
 * 软件启动后由 ADC 自身连续重复转换，不使用定时器；FIFO 每次把两个
 * 12 位结果打包为一个32位字，DMA_CH1负责搬入驱动双缓冲区。
 */
ADC122.$name                          = "ADC1_FAST";
ADC122.repeatMode                     = true;
ADC122.sampleTime0                    = "62.5 ns";
ADC122.powerDownMode                  = "DL_ADC12_POWER_DOWN_MODE_MANUAL";
ADC122.enableFIFO                     = true;
ADC122.configureDMA                   = true;
ADC122.sampCnt                        = 6;
ADC122.enabledDMATriggers             = ["DL_ADC12_DMA_MEM10_RESULT_LOADED"];
ADC122.enabledInterrupts              = ["DL_ADC12_INTERRUPT_DMA_DONE"];
ADC122.adcMem0chansel                 = "DL_ADC12_INPUT_CHAN_14";
ADC122.peripheral.$assign             = "ADC1";
ADC122.peripheral.adcPin14.$assign    = "PB27";
ADC122.adcPin14Config.$name           = "ti_driverlib_gpio_GPIOPinGeneric3";
ADC122.adcPin14Config.hideOutputInversion = scripting.forceWrite(false);
ADC122.DMA_CHANNEL.$name              = "ADC1_FAST_DMA";
ADC122.DMA_CHANNEL.addressMode        = "f2b";
ADC122.DMA_CHANNEL.peripheral.$assign = "DMA_CH1";

/*
 * DAC0固定输出脚为PA15。DMA_CH2循环搬运波形表，DAC内部采样发生器负责
 * 更新节拍，不占用通用定时器。采样发生器默认关闭，由驱动按需启动。
 */
const gate8 = system.clockTree["MFPCLKGATE"];
gate8.enable = true;
DAC12.dacConfigureDMA                = true;
DAC12.dacFIFOEn                      = true;
DAC12.dacFIFOThresh                  = "TWO_QTRS_EMPTY";
DAC12.dacFIFOTrigger                 = "SAMPLETIMER";
DAC12.dacEnabledInterrupts           = ["FIFO_UNDERRUN"];
DAC12.dacOutputPinEn                 = true;
DAC12.dacAmplifier                   = "ON";
DAC12.dacSampleTimerEn               = true;
DAC12.dacSampleTimerRate             = "1M";
DAC12.peripheral.$assign             = "DAC0";
DAC12.peripheral.OutPin.$assign      = "PA15";
DAC12.OutPinConfig.$name             = "DAC0_OUT_PIN_CONFIG";
DAC12.OutPinConfig.hideOutputInversion = scripting.forceWrite(false);
DAC12.DMA_CHANNEL.$name              = "DAC_DMA";
DAC12.DMA_CHANNEL.transferMode       = "FULL_CH_REPEAT_SINGLE";
DAC12.DMA_CHANNEL.addressMode        = "b2f";
DAC12.DMA_CHANNEL.srcLength          = "HALF_WORD";
DAC12.DMA_CHANNEL.dstLength          = "HALF_WORD";
DAC12.DMA_CHANNEL.peripheral.$assign = "DMA_CH2";

const Board = scripting.addModule("/ti/driverlib/Board", {}, false);

